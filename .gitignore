# --- Data (regenerable from raw + preprocessing scripts) ---
data/processed/*
!data/processed/.gitkeep

# --- Model checkpoints and all generated model-directory contents ---
# Model artefacts are large/regenerable and are transferred separately
# between VS Code/Colab (Google Drive recommended).
models/**
!models/.gitkeep

# --- Raw per-fold / per-seed prediction dumps ---
results/raw/*
!results/raw/.gitkeep

# --- Python ---
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/
*.egg-info/

# --- OS / editor ---
.DS_Store
.vscode/
